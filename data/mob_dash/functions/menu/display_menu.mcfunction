execute unless entity @s[tag=md_op] run tellraw @s [{"text":"- "},{"text":"[","color":"gold","bold": true},{"text":"Hostiles: ", "color":"green", "extra": [{"nbt":"Hostiles","storage":"mob_dash:data","color":"aqua"}]},{"text":"]","color":"gold", "bold": true}]
