# Show the tutorial

execute if score @s md_menu_ticks matches 2980 run return run tellraw @s [  "\n", {text: "Mob Dash!", color:gold}, {text: " is a game about frantically hunting mobs. The game will call out a target mob, and the first team to kill that mob gets the points."}, {storage:"mob_dash:data", nbt:CancelTutorialButton, interpret:true}]
execute if score @s md_menu_ticks matches 2880 run return run tellraw @s [ "\n", {text: "When you first join the game, you'll be placed on a random team. Use the "}, {text: "Switch Teams", color: "#FF46B6"}, {text: " menu option to select a team."}, {storage:"mob_dash:data", nbt:CancelTutorialButton, interpret:true}]
execute if score @s md_menu_ticks matches 2780 run return run tellraw @s [ "\n", {text: "Game settings in the menu include the following: "}, {storage:"mob_dash:data", nbt:CancelTutorialButton, interpret:true}]
execute if score @s md_menu_ticks matches 2700 run return run tellraw @s [ "\n", {text: "Win Score Limit", color:"#FF46B6"}, {text:" controls how many points (if any) a team needs to get to win."}, {storage:"mob_dash:data", nbt:CancelTutorialButton, interpret:true}]
execute if score @s md_menu_ticks matches 2600 run return run tellraw @s [ "\n", {text: "Time Limit", color:"#FF46B6"}, {text:" controls how long players have until the game ends."}, {storage:"mob_dash:data", nbt:CancelTutorialButton, interpret:true}]
execute if score @s md_menu_ticks matches 2500 run return run tellraw @s [ "\n", {text: "Difficulty Scaling", color:"#FF46B6"}, {text:" controls how quickly the game will start assigning harder mob targets."}, {storage:"mob_dash:data", nbt:CancelTutorialButton, interpret:true}]
execute if score @s md_menu_ticks matches 2400 run return run tellraw @s [ "\n", {text: "Points Increase Every", color:"#FF46B6"}, {text:" controls how often each mob's point value increases."}, {storage:"mob_dash:data", nbt:CancelTutorialButton, interpret:true}]
execute if score @s md_menu_ticks matches 2300 run return run tellraw @s [ "\n", {text: "Passive-only Start", color:"#FF46B6"}, {text:" toggle controls whether to only have passive mobs at the start."}, {storage:"mob_dash:data", nbt:CancelTutorialButton, interpret:true}]
execute if score @s md_menu_ticks matches 2200 run return run tellraw @s [ "\n", {text: "Hostile", color:"#FF46B6"}, {text: " toggle controls whether hostile mobs can be chosen by the game."}, {storage:"mob_dash:data", nbt:CancelTutorialButton, interpret:true}]
execute if score @s md_menu_ticks matches 2100 run return run tellraw @s [ "\n", {text: "Nether", color:"#FF46B6"}, {text:" toggle controls whether nether mobs can be chosen by the game."}, {storage:"mob_dash:data", nbt:CancelTutorialButton, interpret:true}]
execute if score @s md_menu_ticks matches 2000 run return run tellraw @s ["\n", {text: "When everyone is ready, start the game using the "}, {text:"Start Game", color:"#FF46B6"}, {text:" menu option."}]

execute if score @s md_menu_ticks matches 1900 run function mob_dash:menu/cancel_tutorial