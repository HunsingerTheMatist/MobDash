# Show the tutorial

execute if score @s md_menu_ticks matches 20 run tellraw @s ["\n", {"text": "Mob Dash!", "color": "gold"}, {"text": " is a game about frantically hunting mobs. The game will call out a target mob, and the first team to kill that mob gets the points."}, {"text":" [","color":"gold","bold": true},{"text":"X", "color":"green","click_event":{"action":"run_command", "command":"/scoreboard players set @s md_action 2"},"hover_event": {"action": "show_text","value": {"text":"Cancel Tutorial"}}},{"text":"]","color":"gold", "bold": true}]

