# Display the action bar

# Case for 1, 2, or 3 selected mobs as well as pluralization of "point" for each case
execute if score $TargetCount md_state matches 1 if score @e[type=marker,tag=md_selected1,limit=1] md_score matches 1 run title @a actionbar ["",{"text":"Target: ","color":"gold"},{"selector":"@e[type=marker,tag=md_selected1]","color":"red"}, {"text": " (", "color":"gold"}, {"score": {"name": "@e[type=marker,tag=md_selected1,limit=1]", "objective": "md_score"}, "color":"gold"}, {"text": " point)", "color":"gold"}]
